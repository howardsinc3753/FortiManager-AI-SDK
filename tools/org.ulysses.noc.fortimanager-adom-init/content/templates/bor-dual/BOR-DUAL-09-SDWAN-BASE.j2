config system sdwan
    set status enable
    config zone
        edit "SDWAN_ZONE"
        next
        edit "Underlay_ZONE"
        next
    end
    config members
        edit 1
            set interface "BOR_Primary1"
            set zone "SDWAN_ZONE"
        next
        edit 2
            set interface "BOR_Primary2"
            set zone "SDWAN_ZONE"
        next
        edit 3
            set interface "BOR_Secondary1"
            set zone "SDWAN_ZONE"
        next
        edit 4
            set interface "BOR_Secondary2"
            set zone "SDWAN_ZONE"
        next
        edit 5
            set interface "{{ WAN_PORT }}"
            set zone "Underlay_ZONE"
{% if WAN_MODE == "static" %}            set gateway {{ WAN_GATEWAY }}
{% endif %}        next
        edit 6
            set interface "{{ WAN2_PORT }}"
            set zone "Underlay_ZONE"
{% if WAN_MODE == "static" %}            set gateway {{ WAN2_GATEWAY }}
{% endif %}        next
    end
    config health-check
        edit "HC_Primary1"
            set server "{{ POP1_PROBE }}"
            set failtime 2
            set recoverytime 3
            set update-static-route disable
            set members 1
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
        edit "HC_Primary2"
            set server "{{ POP1_PROBE }}"
            set failtime 2
            set recoverytime 3
            set update-static-route disable
            set members 2
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
        edit "HC_Secondary1"
            set server "{{ POP2_PROBE }}"
            set failtime 2
            set recoverytime 3
            set update-static-route disable
            set members 3
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
        edit "HC_Secondary2"
            set server "{{ POP2_PROBE }}"
            set failtime 2
            set recoverytime 3
            set update-static-route disable
            set members 4
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
    end
    config neighbor
        edit "172.16.0.1"
            set member 1
            set health-check "HC_Primary1"
            set sla-id 1
        next
        edit "172.16.16.1"
            set member 2
            set health-check "HC_Primary2"
            set sla-id 1
        next
        edit "172.16.8.1"
            set member 3
            set health-check "HC_Secondary1"
            set sla-id 1
        next
        edit "172.16.24.1"
            set member 4
            set health-check "HC_Secondary2"
            set sla-id 1
        next
    end
end
