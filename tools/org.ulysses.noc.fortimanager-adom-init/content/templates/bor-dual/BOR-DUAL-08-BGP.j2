config router prefix-list
    edit "PL_LAN_LOCAL"
        config rule
            edit 1
                set prefix {{ LAN_SUBNET }} {{ LAN_MASK }}
            next
        end
    next
end
{# ---- PRIMARY_POP flip (contract v1.2) - DUAL case ----
   When PRIMARY_POP=2, the (community, local_pref) VALUES swap at the GROUP level:
   Primary group (Primary1/Primary2) trades with Secondary group (Secondary1/Secondary2)
   so the Secondary group becomes preferred for BOTH private-access AND INET.
   Route-map NAMES stay (RM_OUT_PRIMARY1/2/SECONDARY1/2) so BGP-neighbor bindings +
   install history never churn; only the values inside change.
   Community + LP values are BGP-tag POSITIONAL CONSTANTS (matches App generator's
   AS:(10k) / lp = 200 - (k-1)*5 formula), so they render as literals from within
   the conditional branches - not tenant-configurable in either codepath.
   NOTE: FMG Jinja doesn't propagate {% set %} bindings across the config block
   (gotcha #20). Inline conditionals only.
#}
config router route-map
    edit "RM_OUT_PRIMARY1"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ '65001:30' if (PRIMARY_POP | string) == '2' else '65001:10' }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ 190 if (PRIMARY_POP | string) == '2' else 200 }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_PRIMARY2"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ '65001:40' if (PRIMARY_POP | string) == '2' else '65001:20' }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ 185 if (PRIMARY_POP | string) == '2' else 195 }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_SECONDARY1"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ '65001:10' if (PRIMARY_POP | string) == '2' else '65001:30' }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ 200 if (PRIMARY_POP | string) == '2' else 190 }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_SECONDARY2"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ '65001:20' if (PRIMARY_POP | string) == '2' else '65001:40' }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ 195 if (PRIMARY_POP | string) == '2' else 185 }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_FAIL"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ FAIL_COMMUNITY }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ FAIL_LOCAL_PREF }}
            next
            edit 99
            next
        end
    next
end
config router bgp
    set as {{ BGP_AS }}
    set router-id {{ ROUTER_ID }}
    set keepalive-timer {{ BGP_KEEPALIVE }}
    set holdtime-timer {{ BGP_HOLDTIME }}
    set ibgp-multipath enable
    set recursive-next-hop enable
    set scan-time 5
    set graceful-restart enable
    config neighbor
        edit "172.16.0.1"
            set interface "BOR_Primary1"
            set update-source "BOR_Primary1"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_PRIMARY1"
            set send-community both
        next
        edit "172.16.16.1"
            set interface "BOR_Primary2"
            set update-source "BOR_Primary2"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_PRIMARY2"
            set send-community both
        next
        edit "172.16.8.1"
            set interface "BOR_Secondary1"
            set update-source "BOR_Secondary1"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_SECONDARY1"
            set send-community both
        next
        edit "172.16.24.1"
            set interface "BOR_Secondary2"
            set update-source "BOR_Secondary2"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_SECONDARY2"
            set send-community both
        next
    end
    config network
        edit 1
            set prefix {{ LAN_SUBNET }} {{ LAN_MASK }}
        next
    end
end
