{# ---- PRIMARY_POP flip (contract v1.1) + role-based object names (v1.1 naming fix) ----
   Object names are LITERAL role strings (BOR_Primary/BOR_Secondary, RM_OUT_PRIMARY/
   RM_OUT_SECONDARY) — stable across every tenant regardless of PoP identity, so a
   multi-tenant NOC reads them universally.  POP1_NAME/POP2_NAME are DISPLAY identity
   only (used in `set comment` for human context).
   When PRIMARY_POP=2, the (community, local_pref) VALUES swap between the two PoP
   route-maps so POP2 becomes preferred for both private-access AND INET.  The
   route-map NAMES don't change on the flip — only the values inside; BGP-neighbor
   bindings never churn.
   NOTE: FMG's Jinja parser doesn't propagate {% set %} bindings across the config
   block (gotcha #20). Use inline conditionals at each substitution instead.
#}
config router prefix-list
    edit "PL_LAN_LOCAL"
        config rule
            edit 1
                set prefix {{ LAN_SUBNET }} {{ LAN_MASK }}
            next
        end
    next
end
config router route-map
    edit "RM_OUT_PRIMARY"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ POP2_COMMUNITY if (PRIMARY_POP | string) == '2' else POP1_COMMUNITY }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ POP2_LOCAL_PREF if (PRIMARY_POP | string) == '2' else POP1_LOCAL_PREF }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_SECONDARY"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ POP1_COMMUNITY if (PRIMARY_POP | string) == '2' else POP2_COMMUNITY }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ POP1_LOCAL_PREF if (PRIMARY_POP | string) == '2' else POP2_LOCAL_PREF }}
            next
            edit 99
            next
        end
    next
    edit "RM_OUT_FAIL"
        config rule
            edit 1
                set match-ip-address "PL_LAN_LOCAL"
                set set-community "{{ FAIL_COMMUNITY }}" "65001:{{ 1000 + (SITE_ID | int) }}"
                set set-local-preference {{ FAIL_LOCAL_PREF }}
            next
            edit 99
            next
        end
    next
end
config router bgp
    set as {{ BGP_AS }}
    set router-id {{ ROUTER_ID }}
    set keepalive-timer {{ BGP_KEEPALIVE }}
    set holdtime-timer {{ BGP_HOLDTIME }}
    set ibgp-multipath enable
    set recursive-next-hop enable
    set scan-time 5
    set graceful-restart enable
    config neighbor
        edit "{{ POP1_BOR_NODE }}"
            set interface "BOR_Primary"
            set update-source "BOR_Primary"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_PRIMARY"
            set send-community both
        next
        edit "{{ POP2_BOR_NODE }}"
            set interface "BOR_Secondary"
            set update-source "BOR_Secondary"
            set remote-as {{ BGP_AS }}
            set advertisement-interval 1
            set connect-timer 1
            set capability-graceful-restart enable
            set link-down-failover enable
            set next-hop-self enable
            set soft-reconfiguration enable
            set route-map-out "RM_OUT_FAIL"
            set route-map-out-preferable "RM_OUT_SECONDARY"
            set send-community both
        next
    end
    config network
        edit 1
            set prefix {{ LAN_SUBNET }} {{ LAN_MASK }}
        next
    end
end
