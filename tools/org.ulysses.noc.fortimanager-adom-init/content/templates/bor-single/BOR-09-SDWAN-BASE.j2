config system sdwan
    set status enable
    config zone
        edit "SDWAN_ZONE"
        next
        edit "Underlay_ZONE"
        next
    end
    config members
        edit 1
            set interface "BOR_{{ POP1_NAME }}"
            set zone "SDWAN_ZONE"
        next
        edit 2
            set interface "BOR_{{ POP2_NAME }}"
            set zone "SDWAN_ZONE"
        next
        edit 3
            set interface "{{ WAN_PORT }}"
            set zone "Underlay_ZONE"
{% if WAN_MODE == "static" %}            set gateway {{ WAN_GATEWAY }}
{% endif %}        next
    end
    config health-check
        edit "HC_{{ POP1_NAME }}"
            set server "{{ POP1_PROBE }}"
            set failtime 2
            set recoverytime 3
            set members 1
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
        edit "HC_{{ POP2_NAME }}"
            set server "{{ POP2_PROBE }}"
            set failtime 2
            set recoverytime 3
            set members 2
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold {{ SLA_LATENCY_MS }}
                    set jitter-threshold {{ SLA_JITTER_MS }}
                    set packetloss-threshold {{ SLA_PKTLOSS_PCT }}
                next
            end
        next
    end
    config neighbor
        edit "{{ POP1_BOR_NODE }}"
            set member 1
            set health-check "HC_{{ POP1_NAME }}"
            set sla-id 1
        next
        edit "{{ POP2_BOR_NODE }}"
            set member 2
            set health-check "HC_{{ POP2_NAME }}"
            set sla-id 1
        next
    end
end
