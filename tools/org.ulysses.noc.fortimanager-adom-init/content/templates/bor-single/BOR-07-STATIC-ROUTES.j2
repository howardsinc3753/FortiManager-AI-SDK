config router static
    edit 1
{% if WAN_MODE == "static" %}        set gateway {{ WAN_GATEWAY }}
{% else %}        set dynamic-gateway enable
{% endif %}        set distance 20
        set device "{{ WAN_PORT }}"
        set comment "Floating WAN default (fallback; primary via on-ramps)"
    next
    edit 5
        set dst {{ POP1_BOR_NODE }} 255.255.255.255
        set device "BOR_Primary"
        set comment "BOR Primary node (BGP peer, {{ POP1_NAME }} PoP)"
    next
    edit 6
        set dst {{ POP2_BOR_NODE }} 255.255.255.255
        set device "BOR_Secondary"
        set comment "BOR Secondary node (BGP peer, {{ POP2_NAME }} PoP)"
    next
    edit 20
        set dstaddr "BOR_Primary_PUBLIC"
{% if WAN_MODE == "static" %}        set gateway {{ WAN_GATEWAY }}
{% else %}        set dynamic-gateway enable
{% endif %}        set device "{{ WAN_PORT }}"
        set comment "BOR Primary PoP public via WAN ({{ POP1_NAME }})"
    next
    edit 21
        set dstaddr "BOR_Secondary_PUBLIC"
{% if WAN_MODE == "static" %}        set gateway {{ WAN_GATEWAY }}
{% else %}        set dynamic-gateway enable
{% endif %}        set device "{{ WAN_PORT }}"
        set comment "BOR Secondary PoP public via WAN ({{ POP2_NAME }})"
    next
    edit 10
        set dst {{ BASTION_IP }} {{ BASTION_MASK }}
{% if WAN_MODE == "dhcp" %}        set dynamic-gateway enable
{% else %}        set gateway {{ WAN_GATEWAY }}
{% endif %}        set device "{{ WAN_PORT }}"
        set comment "Bastion / management return path (trusted host)"
    next
end
