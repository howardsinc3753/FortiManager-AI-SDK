{# ---- PRIMARY_POP flip (contract v1.1) ----
   When PRIMARY_POP=2, priority-members flips (1 2 -> 2 1) and SLA member order
   flips so cfg-order tie-break consistently prefers the POP2 health-check.
   Inline conditionals (not {% set %}) — FMG Jinja doesn't propagate set-bindings
   across the config block (gotcha #20).
#}
config system sdwan
    config service
        edit 1
            set name "BOR_Private_Access"
            set mode sla
            set dst "RFC1918-GRP"
            set tie-break cfg-order
            set priority-members {{ '2 1' if (PRIMARY_POP | string) == '2' else '1 2' }}
            config sla
                edit "HC_{{ POP2_NAME if (PRIMARY_POP | string) == '2' else POP1_NAME }}"
                    set id 1
                next
                edit "HC_{{ POP1_NAME if (PRIMARY_POP | string) == '2' else POP2_NAME }}"
                    set id 1
                next
            end
        next
        edit 2
            set name "INET_via_BOR"
            set mode sla
            set dst "all"
            set tie-break cfg-order
            set priority-members {{ '2 1' if (PRIMARY_POP | string) == '2' else '1 2' }}
            config sla
                edit "HC_{{ POP2_NAME if (PRIMARY_POP | string) == '2' else POP1_NAME }}"
                    set id 1
                next
                edit "HC_{{ POP1_NAME if (PRIMARY_POP | string) == '2' else POP2_NAME }}"
                    set id 1
                next
            end
        next
        edit 5
            set name "Underlay_fallback"
            set dst "all"
            set priority-members 3
        next
    end
end
