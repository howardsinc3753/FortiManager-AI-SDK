{# ---- PRIMARY_POP flip (contract v1.1) + role-based naming (v1.1 naming fix) ----
   HC names are LITERAL role strings (HC_Primary/HC_Secondary) — universal across
   tenants. When PRIMARY_POP=2, priority-members flips (1 2 -> 2 1) and SLA member
   order flips so cfg-order tie-break consistently prefers the Secondary HC.
   Inline conditionals only (FMG Jinja doesn't propagate {% set %} — gotcha #20).
#}
config system sdwan
    config service
        edit 1
            set name "BOR_Private_Access"
            set mode sla
            set dst "RFC1918-GRP"
            set tie-break cfg-order
            set priority-members {{ '2 1' if (PRIMARY_POP | string) == '2' else '1 2' }}
            config sla
                edit "{{ 'HC_Secondary' if (PRIMARY_POP | string) == '2' else 'HC_Primary' }}"
                    set id 1
                next
                edit "{{ 'HC_Primary' if (PRIMARY_POP | string) == '2' else 'HC_Secondary' }}"
                    set id 1
                next
            end
        next
        edit 2
            set name "INET_via_BOR"
            set mode sla
            set dst "all"
            set tie-break cfg-order
            set priority-members {{ '2 1' if (PRIMARY_POP | string) == '2' else '1 2' }}
            config sla
                edit "{{ 'HC_Secondary' if (PRIMARY_POP | string) == '2' else 'HC_Primary' }}"
                    set id 1
                next
                edit "{{ 'HC_Primary' if (PRIMARY_POP | string) == '2' else 'HC_Secondary' }}"
                    set id 1
                next
            end
        next
        edit 5
            set name "Underlay_fallback"
            set dst "all"
            set priority-members 3
        next
    end
end
