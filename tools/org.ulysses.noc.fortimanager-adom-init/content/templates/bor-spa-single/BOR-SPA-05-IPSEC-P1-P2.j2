config vpn ipsec phase1-interface
    edit "BOR_{{ POP1_NAME }}"
        set type ddns
        set interface "{{ WAN_PORT }}"
        set ike-version 2
        set peertype any
        set net-device disable
        set mode-cfg enable
        set proposal {{ ONRAMP_PROPOSAL }}
        set dhgrp {{ ONRAMP_DHGRP }}
        set network-overlay enable
        set network-id {{ ONRAMP_NETWORK_ID }}
        set transport auto
        set fortinet-esp enable
        set dpd on-idle
        set remotegw-ddns "{{ POP1_FQDN }}"
        set psksecret {{ SEED_PSK }}
    next
    edit "BOR_{{ POP2_NAME }}"
        set type ddns
        set interface "{{ WAN_PORT }}"
        set ike-version 2
        set peertype any
        set net-device disable
        set mode-cfg enable
        set proposal {{ ONRAMP_PROPOSAL }}
        set dhgrp {{ ONRAMP_DHGRP }}
        set network-overlay enable
        set network-id {{ ONRAMP_NETWORK_ID }}
        set transport auto
        set fortinet-esp enable
        set dpd on-idle
        set remotegw-ddns "{{ POP2_FQDN }}"
        set psksecret {{ SEED_PSK }}
    next
end
config vpn ipsec phase2-interface
    edit "BOR_{{ POP1_NAME }}"
        set phase1name "BOR_{{ POP1_NAME }}"
        set proposal {{ ONRAMP_PROPOSAL }}
        set dhgrp {{ ONRAMP_DHGRP }}
    next
    edit "BOR_{{ POP2_NAME }}"
        set phase1name "BOR_{{ POP2_NAME }}"
        set proposal {{ ONRAMP_PROPOSAL }}
        set dhgrp {{ ONRAMP_DHGRP }}
    next
end
